# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Geleceğin Dijital Sağlık Liderleri Backend
#
# Bu dosyayı kopyalayıp .env adıyla kaydedin:
#   cp .env.example .env
#
# .env dosyasını ASLA git'e commit etmeyin (.gitignore'da tanımlı olmalı).
# ─────────────────────────────────────────────────────────────────────────────

# ── AI Provider Seçimi ────────────────────────────────────────────────────────
# Hangi AI servisinin kullanılacağını belirler: openai | gemini
# Boş bırakılırsa veya tanımlanmazsa varsayılan: openai
AI_PROVIDER=openai

# ── OpenAI Entegrasyonu (AI_PROVIDER=openai) ──────────────────────────────────
# API key boş bırakılırsa sistem placeholder rapor döner (fallback mod).
# Gerçek AI için OpenAI dashboard'dan edindiğiniz key'i buraya yazın:
OPENAI_API_KEY=

# Kullanılacak OpenAI model adı. Boş bırakılırsa varsayılan: gpt-4.1-mini
OPENAI_MODEL=gpt-4.1-mini

# ── Gemini Entegrasyonu (AI_PROVIDER=gemini) ──────────────────────────────────
# API key boş bırakılırsa sistem HATA verir (fallback yok).
# Google AI Studio'dan (aistudio.google.com) edindiğiniz key'i buraya yazın:
GEMINI_API_KEY=

# Kullanılacak Gemini model adı. Boş bırakılırsa varsayılan: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# ── Ek Seçenekler ─────────────────────────────────────────────────────────────
# OpenAI key yokken sistemi durdurmak için true yapın (opsiyonel):
AI_REQUIRE_OPENAI=false

# ── Django ────────────────────────────────────────────────────────────────────
# Üretim ortamında mutlaka değiştirin:
# DJANGO_SECRET_KEY=
# DEBUG=False
# ALLOWED_HOSTS=yourdomain.com

# ── Veritabanı (Database) ─────────────────────────────────────────────────────
# Tanımlanmazsa → yerel SQLite kullanılır (geliştirme ortamı).
# Supabase/PostgreSQL için örnek format:
#   postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Supabase bağlantısı Transaction Mode (port 6543) üzerinden önerilir:
#   postgresql://postgres.XXXX:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
